# ============================================================
# Cement Stock Management Bot - Environment Configuration
# ============================================================

# --- Telegram Bot ---
BOT_TOKEN=your_telegram_bot_token_here

# --- Admin Setup ---
# Secret key used to self-register the first admin
ADMIN_SETUP_KEY=change_this_to_a_strong_secret

# --- Database ---
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///cement_stock.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cement_stock

# --- Application Settings ---
# Default low stock threshold in kg (can be changed via /set_low_stock)
DEFAULT_LOW_STOCK_KG=20000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timezone for timestamps (e.g. Africa/Addis_Ababa, UTC, Europe/London)
TIMEZONE=Africa/Addis_Ababa
